{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile metadata stored under users/{uid}.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name for the authenticated user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Email address of the authenticated user."
        },
        "plan": {
          "type": "string",
          "enum": ["Free", "Pro", "Team"],
          "description": "Current workspace plan tier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was created."
        }
      },
      "required": ["displayName", "email", "plan", "createdAt"]
    },
    "Folder": {
      "title": "Folder",
      "description": "User-owned folder for organizing file metadata.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Folder display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the folder was created."
        }
      },
      "required": ["name", "createdAt"]
    },
    "FileItem": {
      "title": "FileItem",
      "description": "Metadata-only file entry owned by the user.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "File name including extension."
        },
        "folderId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional parent folder document ID."
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Human-readable file size metadata (e.g., 2.4 MB)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the file metadata was created."
        }
      },
      "required": ["name", "size", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Personal workspace note owned by the user.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Note title."
        },
        "content": {
          "type": "string",
          "maxLength": 10000,
          "description": "Optional note body text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the note was created."
        }
      },
      "required": ["title", "createdAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Team member directory entry owned by the user.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Team member full name."
        },
        "role": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional role or title."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the team member was added."
        }
      },
      "required": ["name", "createdAt"]
    },
    "SurveyResponse": {
      "title": "SurveyResponse",
      "description": "Shared research survey submission readable by authenticated dashboard researchers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "timestamp": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "maxLength": 120 },
        "city": { "type": "string", "maxLength": 120 },
        "consent": { "type": "boolean" },
        "q1": { "type": "string", "maxLength": 80 },
        "q2": { "type": "string", "maxLength": 80 },
        "q3": { "type": "string", "maxLength": 80 },
        "q4": { "type": "string", "maxLength": 80 },
        "q5": { "type": "string", "maxLength": 80 },
        "q6": { "type": "string", "maxLength": 80 },
        "q7": { "type": "string", "maxLength": 80 },
        "q8": { "type": "string", "maxLength": 80 },
        "q9": { "type": "string", "maxLength": 80 },
        "q10": { "type": "string", "maxLength": 80 },
        "q11": { "type": "string", "maxLength": 80 },
        "q12": { "type": "string", "maxLength": 80 },
        "q13": { "type": "string", "maxLength": 80 },
        "q14": { "type": "string", "maxLength": 80 },
        "q15": { "type": "string", "maxLength": 80 },
        "q16": { "type": "string", "maxLength": 80 },
        "q17": { "type": "string", "maxLength": 80 },
        "q18": { "type": "string", "maxLength": 80 },
        "q19": { "type": "string", "maxLength": 80 },
        "q20": { "type": "string", "maxLength": 80 },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the survey response was submitted."
        }
      },
      "required": [
        "id", "timestamp", "name", "city", "consent",
        "q1", "q2", "q3", "q4", "q5", "q6", "q7", "q8", "q9", "q10",
        "q11", "q12", "q13", "q14", "q15", "q16", "q17", "q18", "q19", "q20",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document isolated per authenticated UID."
    },
    "/users/{uid}/folders/{folderId}": {
      "schema": { "$ref": "#/entities/Folder" },
      "description": "Folders belonging exclusively to the authenticated user."
    },
    "/users/{uid}/files/{fileId}": {
      "schema": { "$ref": "#/entities/FileItem" },
      "description": "File metadata entries belonging exclusively to the authenticated user."
    },
    "/users/{uid}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Notes belonging exclusively to the authenticated user."
    },
    "/users/{uid}/teamMembers/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Team members belonging exclusively to the authenticated user."
    },
    "/surveyResponses/{responseId}": {
      "schema": { "$ref": "#/entities/SurveyResponse" },
      "description": "Shared research survey responses synced across researchers."
    }
  }
}
